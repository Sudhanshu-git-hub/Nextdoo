# ---- required
# PostgreSQL connection string. `pnpm dev:services` starts a local instance on 55432.
DATABASE_URL=postgres://postgres:postgres@localhost:55432/nextdoo
# 32+ characters. Used to derive session and encryption keys.
AUTH_SECRET=replace-me-with-at-least-32-random-characters
APP_URL=http://localhost:3000

# ---- optional; each feature is disabled when its config is absent
# Durable queue and rate limiting. Falls back to an in-process adapter when unset.
REDIS_URL=
# Google Calendar sync
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Billing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# S3-compatible attachment storage
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

LOG_LEVEL=info
