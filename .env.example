# ---- required
# PostgreSQL connection string. `pnpm dev:services` starts a local instance on 55432.
DATABASE_URL=postgres://postgres:postgres@localhost:55432/nextdoo
# 32+ characters. Used to derive session and encryption keys.
AUTH_SECRET=replace-me-with-at-least-32-random-characters
APP_URL=http://localhost:3000

# Durable directory for generated export artifacts (default: ./var/exports under the app cwd).
# Web and worker must agree on this value. Managed object storage (S3 or
# equivalent) is a documented switching point, not yet wired.
EXPORT_STORAGE_DIR=

# ---- reserved/optional configuration; integrations are not all implemented (see docs/DEVELOPMENT.md)
# Reserved: Redis is not wired. Login/export limits and SMTP delivery use PostgreSQL.
REDIS_URL=
# Google Calendar sync
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Billing (TEST MODE ONLY — a provider is enabled only with a COMPLETE test-mode
# configuration: API key + webhook secret + all three plan mappings. Otherwise
# billing endpoints answer 503 PROVIDER_UNAVAILABLE. Stripe prices are USD,
# Razorpay plans are INR.)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PLANS={"PRO":"price_...","TEAM":"price_...","ENTERPRISE":"price_..."}
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLANS={"PRO":{"id":"plan_...","amountPaise":199900},"TEAM":{"id":"plan_...","amountPaise":499900},"ENTERPRISE":{"id":"plan_...","amountPaise":999900}}
# S3-compatible attachment storage
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

LOG_LEVEL=info

# SMTP auth-email adapter: export to BOTH web and worker, with the same AUTH_SECRET.
# Production requires TLS and a verified sender; see docs/DEVELOPMENT.md.
SMTP_URL=
MAIL_FROM=NEXTDOO <no-reply@nextdoo.local>
